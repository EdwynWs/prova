{
  "openapi": "3.0.0",
  "info": {
    "title": "Kanban - API",
    "description": "API do sistema de gerenciamento de tarefas em formato Kanban",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/"
    }
  ],
  "paths": {
    "/auth/cookie": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Obtém o usuário logado a partir do cookie de autenticação",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Geração de token de autenticação",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/login"
              }
            }
          }
        }
      }
    },
    "/tarefas/": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Lista todas as tarefas. Pode filtrar por status via query param ?status=a_fazer|em_andamento|em_revisao|concluido",
        "description": "",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Cadastra uma nova tarefa",
        "description": "",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tarefa"
              }
            }
          }
        }
      }
    },
    "/tarefas/resumo": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Retorna a contagem de tarefas agrupadas por status (para o Dashboard)",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/tarefas/{id}": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Obtém uma tarefa pelo ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Atualiza todos os dados de uma tarefa",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tarefa"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Exclui (soft delete) uma tarefa",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/tarefas/{id}/status": {
      "patch": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Move uma tarefa para outro status (coluna do Kanban)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/moverStatus"
              }
            }
          }
        }
      }
    },
    "/usuarios/": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Lista todos os usuários (para seleção de responsável)",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "erro": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "example": "Mensagem de erro"
          }
        }
      },
      "login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@email.com"
          },
          "senha": {
            "type": "string",
            "example": "senha123"
          }
        }
      },
      "tarefa": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Implementar tela de login"
          },
          "descricao": {
            "type": "string",
            "example": "Criar a interface de login com validação de campos"
          },
          "status": {
            "type": "string",
            "example": "a_fazer"
          },
          "dataLimite": {
            "type": "string",
            "example": "2026-06-30"
          },
          "responsavel": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "example": 1
              }
            }
          }
        }
      },
      "moverStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "em_andamento"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}